\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 分箱零点随参考星亮度的变化。$G\in [10,14]$ 内基本平坦（$\pm 0.03$\,mag），$G>14.2$ 后系统抬升，对应暗端的混合与选择效应；判据是“随 $G$ 有趋势而随信噪比无趋势”，故不是噪声整流所致。}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:zp}{{4}{7}{分箱零点随参考星亮度的变化。$G\in [10,14]$ 内基本平坦（$\pm 0.03$\,mag），$G>14.2$ 后系统抬升，对应暗端的混合与选择效应；判据是“随 $G$ 有趋势而随信噪比无趋势”，故不是噪声整流所致。}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 残差随亮度的系统趋势。$G\ge 10.25$ 时 $|\text  {中位残差}|\le 0.03$\,mag，而 $G=9.25$ 与 $9.75$ 处分别为 $-0.150$ 与 $-0.131$\,mag；暗端的正残差意味着 $\ensuremath {g_{\mathrm  {emp}}}$ 偏大、即目标被系统\textbf  {测暗}，故该区间只能带系统项引用。}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:res}{{5}{7}{残差随亮度的系统趋势。$G\ge 10.25$ 时 $|\text {中位残差}|\le 0.03$\,mag，而 $G=9.25$ 与 $9.75$ 处分别为 $-0.150$ 与 $-0.131$\,mag；暗端的正残差意味着 $\gemp $ 偏大、即目标被系统\textbf {测暗}，故该区间只能带系统项引用。}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}15 帧：随机项与共同系统项}{7}{subsection.4.5}\protected@file@percent }
\newlabel{sec:frames}{{4.5}{7}{15 帧：随机项与共同系统项}{subsection.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 零点随视场半径的变化：中心到边缘共 0.094\,mag。这是平场/渐晕的直接证据，也是当前最大的单项系统误差之一；仅用径向二次项只能扣除约 7\%。}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:zprad}{{6}{8}{零点随视场半径的变化：中心到边缘共 0.094\,mag。这是平场/渐晕的直接证据，也是当前最大的单项系统误差之一；仅用径向二次项只能扣除约 7\%。}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 帧间差分散度与光子预期。低信噪比端两者重合，证明随机项已到光子极限；高信噪比端偏离 10 倍以上，来自平场、非线性与饱和尾部。}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:delta}{{7}{8}{帧间差分散度与光子预期。低信噪比端两者重合，证明随机项已到光子极限；高信噪比端偏离 10 倍以上，来自平场、非线性与饱和尾部。}{figure.caption.10}{}}
