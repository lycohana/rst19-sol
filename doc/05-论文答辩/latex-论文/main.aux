\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces FWHM 分布。实现中的 FWHM 门是 $[0.8,12.0]$\,px，对实测 PSF（1.93\,px）近乎不设限，因此两条曲线的差异主要由信噪比门与伪影判据造成；图中宽于 4.6\,px 的长尾已在质量通过样本中消失，是因为它们被判为伪影（拖影由线状判据标记，而非 FWHM 门）。主峰与叠合 PSF 重合。}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:fwhm}{{2}{4}{FWHM 分布。实现中的 FWHM 门是 $[0.8,12.0]$\,px，对实测 PSF（1.93\,px）近乎不设限，因此两条曲线的差异主要由信噪比门与伪影判据造成；图中宽于 4.6\,px 的长尾已在质量通过样本中消失，是因为它们被判为伪影（拖影由线状判据标记，而非 FWHM 门）。主峰与叠合 PSF 重合。}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 质量通过源的匹配滤波信噪比分布（注意：质量门的 5\,$\sigma $ 截断施加在孔径通量信噪比 \texttt  {flux\_snr} 上，而本图绘的是 \texttt  {snr} 列，两者定义不同，故此列在 5 附近并无截断）；该处误差条由背景主导，故其可信度完全取决于第 \ref {sec:errbudget} 节的误差预算。}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:snr}{{3}{4}{质量通过源的匹配滤波信噪比分布（注意：质量门的 5\,$\sigma $ 截断施加在孔径通量信噪比 \texttt {flux\_snr} 上，而本图绘的是 \texttt {snr} 列，两者定义不同，故此列在 5 附近并无截断）；该处误差条由背景主导，故其可信度完全取决于第 \ref {sec:errbudget} 节的误差预算。}{figure.caption.5}{}}
