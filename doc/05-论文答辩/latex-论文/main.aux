\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 分箱零点随参考星亮度的变化。$G\in [10,14]$ 内基本平坦（$\pm 0.03$\,mag），$G>14.2$ 后系统抬升，对应暗端的混合与选择效应；判据是“随 $G$ 有趋势而随信噪比无趋势”，故不是噪声整流所致。}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:zp}{{4}{5}{分箱零点随参考星亮度的变化。$G\in [10,14]$ 内基本平坦（$\pm 0.03$\,mag），$G>14.2$ 后系统抬升，对应暗端的混合与选择效应；判据是“随 $G$ 有趋势而随信噪比无趋势”，故不是噪声整流所致。}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 残差随亮度的系统趋势。$G\lesssim 14$ 时 $|\text  {中位残差}|\le 0.03$\,mag；暗端的正残差意味着目标被系统测亮，故该区间只能带系统项引用。}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:res}{{5}{5}{残差随亮度的系统趋势。$G\lesssim 14$ 时 $|\text {中位残差}|\le 0.03$\,mag；暗端的正残差意味着目标被系统测亮，故该区间只能带系统项引用。}{figure.caption.7}{}}
