\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 零点随视场半径的变化：中心到边缘共 0.094\,mag。这是平场/渐晕的直接证据，也是当前最大的单项系统误差之一；仅用径向二次项只能扣除约 7\%。}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:zprad}{{6}{6}{零点随视场半径的变化：中心到边缘共 0.094\,mag。这是平场/渐晕的直接证据，也是当前最大的单项系统误差之一；仅用径向二次项只能扣除约 7\%。}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 帧间差分散度与光子预期。低信噪比端两者重合，证明随机项已到光子极限；高信噪比端偏离 10 倍以上，来自平场、非线性与饱和尾部。}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:delta}{{7}{6}{帧间差分散度与光子预期。低信噪比端两者重合，证明随机项已到光子极限；高信噪比端偏离 10 倍以上，来自平场、非线性与饱和尾部。}{figure.caption.9}{}}
