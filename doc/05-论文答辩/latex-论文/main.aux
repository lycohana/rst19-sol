\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 第 1 帧峰值分布。(a) 全范围（对数坐标）；(b) 3990--3994\,DN 附近改用 5\,DN 线性分箱后，可以看到 3992\,DN 处的尖峰（881 个候选）与其上方的空白（$[3994,4100)$ 仅 1 个）。这说明存在与“满量程 65535”无关的读出/编码上限，而旧的 $20000$\,DN 饱和判据把它整个漏掉了。}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:peak}{{1}{3}{第 1 帧峰值分布。(a) 全范围（对数坐标）；(b) 3990--3994\,DN 附近改用 5\,DN 线性分箱后，可以看到 3992\,DN 处的尖峰（881 个候选）与其上方的空白（$[3994,4100)$ 仅 1 个）。这说明存在与“满量程 65535”无关的读出/编码上限，而旧的 $20000$\,DN 饱和判据把它整个漏掉了。}{figure.caption.2}{}}
