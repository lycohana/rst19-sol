{"source_hashes":{"sequence.py":"51fcabdb952c8aefa836877da6032d40b8ed91390ce471ec2841137acae54088"},"cases":[{"label":"utc_timestamps_and_fractional_seconds","request":{"headers":[{"DATE-OBS":"2024-02-29T23:59:59.250Z"},{"DATE-OBS":"2024-03-01T00:00:00.750Z"}]},"expected":{"frame_times":[0.0,1.5]}},{"label":"timezone_offsets_normalize_to_utc","request":{"headers":[{"DATE-OBS":"2024-03-01T00:30:00+02:00"},{"DATE-OBS":"2024-02-29T23:45:00+01:00"}]},"expected":{"frame_times":[0.0,900.0]}},{"label":"naive_fits_timestamps_are_assumed_utc","request":{"headers":[{"DATE-OBS":"2024-01-01 23:59:00"},{"DATE-OBS":"2024-01-02 00:01:00"}]},"expected":{"frame_times":[0.0,120.0]}},{"label":"numeric_timezone_offset_without_colon","request":{"headers":[{"DATE-OBS":"2024-01-01T10:00:00+0200"},{"DATE-OBS":"2024-01-01T09:00:30+0100"}]},"expected":{"frame_times":[0.0,30.0]}},{"label":"date_only_values_parse_at_midnight","request":{"headers":[{"DATE-OBS":"2024-01-01"},{"DATE-OBS":"2024-01-02"}]},"expected":{"frame_times":[0.0,86400.0]}},{"label":"missing_date_falls_back_to_frame_index","request":{"headers":[{"DATE-OBS":"2024-01-01T00:00:00Z"},{},{"DATE-OBS":"2024-01-01T00:00:10Z"}]},"expected":{"frame_times":[0.0,1.0,2.0]}},{"label":"null_date_falls_back_to_frame_index","request":{"headers":[{"DATE-OBS":"2024-01-01T00:00:00Z"},{"DATE-OBS":null}]},"expected":{"frame_times":[0.0,1.0]}},{"label":"invalid_timestamp_falls_back_to_frame_index","request":{"headers":[{"DATE-OBS":"2024-01-01T00:00:00Z"},{"DATE-OBS":"not-a-timestamp"}]},"expected":{"frame_times":[0.0,1.0]}},{"label":"duplicate_utc_time_falls_back_to_frame_index","request":{"headers":[{"DATE-OBS":"2024-01-01T00:00:00Z"},{"DATE-OBS":"2024-01-01T00:00:00+00:00"}]},"expected":{"frame_times":[0.0,1.0]}},{"label":"reverse_time_order_falls_back_to_frame_index","request":{"headers":[{"DATE-OBS":"2024-01-01T00:00:10Z"},{"DATE-OBS":"2024-01-01T00:00:00Z"}]},"expected":{"frame_times":[0.0,1.0]}},{"label":"invalid_calendar_date_falls_back_to_frame_index","request":{"headers":[{"DATE-OBS":"2023-02-29T00:00:00Z"},{"DATE-OBS":"2023-03-01T00:00:00Z"}]},"expected":{"frame_times":[0.0,1.0]}},{"label":"offset_crosses_year_boundary","request":{"headers":[{"DATE-OBS":"2024-01-01T00:30:00+01:00"},{"DATE-OBS":"2023-12-31T23:45:00Z"}]},"expected":{"frame_times":[0.0,900.0]}},{"label":"subsecond_offsets_preserve_millisecond_deltas","request":{"headers":[{"DATE-OBS":"2024-06-01T12:00:00.125000Z"},{"DATE-OBS":"2024-06-01T12:00:00.375000Z"}]},"expected":{"frame_times":[0.0,0.25]}},{"label":"offset_seconds_are_applied","request":{"headers":[{"DATE-OBS":"2024-06-01T12:30:00+01:00:30"},{"DATE-OBS":"2024-06-01T12:30:31+01:00:00"}]},"expected":{"frame_times":[0.0,61.0]}},{"label":"hour_and_minute_without_seconds_are_supported","request":{"headers":[{"DATE-OBS":"2024-06-01T12:30.5Z"},{"DATE-OBS":"2024-06-01T12:31:00Z"}]},"expected":{"frame_times":[0.0,59.5]}},{"label":"hour_only_timezone_offset_is_supported","request":{"headers":[{"DATE-OBS":"2024-06-01T10:00:00+02"},{"DATE-OBS":"2024-06-01T08:01:00Z"}]},"expected":{"frame_times":[0.0,60.0]}},{"label":"single_character_plus_separator_uses_python_iso_semantics","request":{"headers":[{"DATE-OBS":"2024-06-01+10:00"},{"DATE-OBS":"2024-06-01T10:00:01"}]},"expected":{"frame_times":[0.0,1.0]}},{"label":"alternate_ascii_datetime_separator_is_accepted","request":{"headers":[{"DATE-OBS":"2024-06-01x10:00:00Z"},{"DATE-OBS":"2024-06-01T10:00:01Z"}]},"expected":{"frame_times":[0.0,1.0]}},{"label":"overlong_fraction_truncates_to_microseconds","request":{"headers":[{"DATE-OBS":"2024-06-01T12:00:00.123456789Z"},{"DATE-OBS":"2024-06-01T12:00:00.123457789Z"}]},"expected":{"frame_times":[0.0,1e-06]}},{"label":"invalid_timezone_offset_falls_back","request":{"headers":[{"DATE-OBS":"2024-06-01T12:00:00+24:00"},{"DATE-OBS":"2024-06-01T13:00:00+24:00"}]},"expected":{"frame_times":[0.0,1.0]}},{"label":"leap_second_falls_back","request":{"headers":[{"DATE-OBS":"2024-06-01T12:00:60Z"},{"DATE-OBS":"2024-06-01T12:01:00Z"}]},"expected":{"frame_times":[0.0,1.0]}}]}
